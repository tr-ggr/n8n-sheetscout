{
  "name": "n8n-sheetscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resume Summarizer to Google Sheets - n8n workflow plus a small TypeScript harness",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
