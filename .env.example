# --- OpenRouter ---------------------------------------------------------
# Create a key at https://openrouter.ai/keys . This is also the value you paste
# into the n8n "Header Auth" credential named "OpenRouter" (header: Authorization,
# value: Bearer <key>).
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Model used by the workflow. gpt-4o-mini is cheap and reliable in JSON mode.
# Alternative: google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Google Sheets -----------------------------------------------------
# The spreadsheetId from https://docs.google.com/spreadsheets/d/<spreadsheetId>/edit
GOOGLE_SHEET_ID=replace-me
# Tab name that holds the header row (see docs/architecture.md)
GOOGLE_SHEET_TAB=Candidates

# --- n8n (local docker) --------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
# Let expressions read $env.OPENROUTER_MODEL / $env.GOOGLE_SHEET_ID inside nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Needed for Google OAuth2 credential redirect when running locally
N8N_EDITOR_BASE_URL=http://localhost:5678/

# --- Generated workflow -------------------------------------------------
# Include the informational Setup notes Sticky Note in `pnpm sync` output.
# Missing defaults to false; only the exact values true and false are accepted.
SETUP_INFO=false
